# hallway.world
include "include/robots.inc"

resolution 0.001
interval_sim 100

define floorplan model
(
  color "gray30"
  boundary 0
  gui_nose 0
  gui_grid 0
  gui_outline 0
  gripper_return 0
  fiducial_return 0
  laser_return 1
)

window
(
  size [ 635.000 666.000 ]
  scale 80
  center [ 0.0 0.0 ]
  rotate [ 0 0 ]
  show_data 1
)

floorplan
(
  name "hallway"
  size [25.0 25.0 0.800]
  pose [0 0 0 0]
  bitmap "bitmaps/hallway.png"
  gui_move 0
)

define my_block model
(
  size [0.5 0.5 0.5]
  gui_nose 0
)

my_block( pose [ 0 -1.5 0 0 ] color "green")

pioneer2dx_with_laser
(
  name "robot_0"
  color "red"
  pose [ -3 0 0 0 ]
)
